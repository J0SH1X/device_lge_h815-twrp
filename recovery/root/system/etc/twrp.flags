# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# Mount point       FS           Device               2nd Device                 Flags
/boot               emmc         /dev/block/bootdevice/by-name/boot              flags=backup=1
/recovery           emmc         /dev/block/bootdevice/by-name/recovery          flags=backup=1

# Direct image flashing
/system_image       emmc         /dev/block/mapper/system            flags=backup=1;flashimg=1
/system_ext       emmc         /dev/block/mapper/system_ext            flags=backup=1;flashimg=1
/product_image      emmc         /dev/block/mapper/product           flags=backup=1;flashimg=1;display="Product Image"
/vendor_image       emmc         /dev/block/mapper/vendor            flags=backup=1;flashimg=1

# ETC Moint Point
/cache              ext4         /dev/block/bootdevice/by-name/cache

# USB-OTG Points
/external_sd        auto         /dev/block/mmcblk0p1   /dev/block/mmcblk0       flags=display="Micro SD card";storage;wipeingui;removable
/usb-otg	        vfat		 /dev/block/sde1	/dev/block/sde			     flags=display="USB-OTG";storage;wipeingui;removable